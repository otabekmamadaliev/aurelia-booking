# --------------------------------------------------------------------------
# Supabase — optional.
#
# Leave both blank and the app runs entirely in the browser: full demo, no
# credentials, no network. Fill them in and reservations become shared across
# every device, with availability enforced inside a Postgres transaction.
#
# Both of these are safe to commit and safe in a client bundle. The anon key is
# designed to be public and grants only what row-level security allows it.
#
#   NEVER put the `service_role` key here. It bypasses RLS completely, and
#   anything in a VITE_* variable is compiled into JavaScript the whole world
#   can read.
#
# Setup instructions: docs/SUPABASE.md
# --------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# --------------------------------------------------------------------------
# EmailJS — optional.
#
# The app ships with working defaults baked into src/lib/email.js; these only
# need setting to point a deployment at a different account. EmailJS public
# keys are publishable by design, so there is no secret here either.
# --------------------------------------------------------------------------

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx

# Address that receives a copy of every confirmation.
VITE_HOTEL_EMAIL=contact@example.com
